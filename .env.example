# TickerBoo environment configuration
# Copy to .env and edit. Never commit .env.

# ── Runtime ────────────────────────────────────────────────────────────
TICKERBOO_ENV=dev          # dev | prod
TICKERBOO_PORT=8688
TICKERBOO_HOST=0.0.0.0     # dev: 0.0.0.0 | prod: 127.0.0.1
TICKERBOO_ROOT_PATH=       # set to /tb when behind nginx subpath proxy

# ── Storage ────────────────────────────────────────────────────────────
TICKERBOO_DB_PATH=./data/tickerboo.db
TICKERBOO_LOG_PATH=./logs/tickerboo.log
TICKERBOO_LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING

# ── Data sources ───────────────────────────────────────────────────────
CAFEF_URL_PREFIX=https://cafef1.mediacdn.vn/data/ami_data/
# DNSE_BASE_URL=https://api.dnse.com.vn   # added in Iter 7

# ── Auth (Iter 8) ──────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SECRET_KEY=change-me-in-production
